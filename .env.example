# ── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgres://studio:studio@localhost:5432/studio
# Separate database used by automated tests (tables are truncated!)
TEST_DATABASE_URL=postgres://studio:studio@localhost:5432/studio_test
# Where generated media, renders and packages are stored
STORAGE_DIR=./data/storage
# API server
HOST=127.0.0.1
PORT=8787
# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500
# Max accepted upload size (MB)
MAX_UPLOAD_MB=200
# Optional overrides for media binaries
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Real providers (NOT implemented in Phase 1; listed so the registry can
#    report configuration status). Never exposed to the browser. ───────────
# GOOGLE_VEO_API_KEY=
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# HIGGSFIELD_API_KEY=
# HIGGSFIELD_MCP_URL=
# ANTHROPIC_API_KEY=
