# ── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgres://studio:studio@localhost:5432/studio
# Separate database used by automated tests (tables are truncated!)
TEST_DATABASE_URL=postgres://studio:studio@localhost:5432/studio_test
# Where generated media, renders and packages are stored
STORAGE_DIR=./data/storage
# API server
HOST=127.0.0.1
PORT=8787
# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500
# Max accepted upload size (MB)
MAX_UPLOAD_MB=200
# Optional overrides for media binaries
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Provider connections ─────────────────────────────────────────────────
# Providers (Google Veo/Gemini, Kling, Higgsfield API/MCP, ElevenLabs, Claude) are connected
# from the Providers page; credentials are encrypted at rest with this key.
# 32 random bytes, base64 (openssl rand -base64 32). If unset, a key file is
# generated next to STORAGE_DIR on first use — set it explicitly in production.
# SECRETS_KEY=
# Public URL of this server, used for OAuth redirects (MCP sign-in).
# Defaults to http://HOST:PORT. Set it when running behind a proxy/domain.
# PUBLIC_BASE_URL=http://127.0.0.1:8787
